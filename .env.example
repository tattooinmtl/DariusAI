# DariusAI Harness — environment overrides.
#
# Optional. Keys entered via the app (File → Settings → Providers) are
# DPAPI-encrypted and stored in the brain directory at ~/.dariusai —
# they are NEVER read or written here. This file is for two cases:
#
#   1. Running the CLI (`dariusai run`, `dariusai chat`) without ever
#      opening the desktop UI. The Settings dialog is where keys go for
#      the app; env vars are the CLI equivalent.
#
#   2. Overriding harness behaviour that has no UI knob yet (see the
#      DARIUSAI_* section at the bottom).
#
# To use: copy this file to `.env` and fill in what you need. `.env` is
# gitignored; `.env.example` is committed as documentation.

# --- Model providers ---------------------------------------------------------
# The harness will use whichever of these is set. If more than one is set
# it prefers Anthropic. If none are set and no in-app provider is configured,
# `dariusai run` and `dariusai chat` will refuse to start with a message
# pointing at Settings.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# MiniMax (M-series LLMs) and other OpenAI-compatible providers live in
# Settings → Providers rather than as environment variables — the harness
# needs both the key and the model list, which env vars can't carry.

# --- Harness behaviour -------------------------------------------------------
# Rarely needed. Everything here has a working default; only set these
# if you hit the specific case each comment describes.

# Cap on tool calls per chat turn. Default 60. Raise for long autonomous
# runs; lower to force the model to be more decisive.
# DARIUSAI_MAX_TOOL_ITERATIONS=60

# Skill payload eviction — how many iterations a skill body stays verbatim
# in the prompt before being replaced with a one-line receipt (the model
# still knows it read the skill; the bytes just aren't re-sent every
# iteration). Default 2. Raise if you're seeing the model re-fetch the
# same skill; lower if long turns are burning context on stale bodies.
# DARIUSAI_SKILL_PAYLOAD_TTL=2

# Minimum stale payload total (chars) before an eviction pass fires.
# Rewriting history invalidates the prompt cache from that point onward,
# so eviction has to be worth the re-write it forces. Default 4000.
# DARIUSAI_SKILL_EVICT_MIN_CHARS=4000

# Full-load byte threshold for `invoke_skill`. Below this size a skill is
# returned whole (the RAG detour would cost more than it saves); above it
# the passage-index treatment kicks in. Default 6000.
# DARIUSAI_SKILL_FULL_LOAD_BYTES=6000
